# ==============================================================
# Dengue Prediction System - Environment Configuration
# ==============================================================
# Copy this file to .env and fill in your API keys.
# Do NOT commit .env to git!
# ==============================================================

# --------------------------------------------------------------
# [REQUIRED] Google Gemini API Key
# Get yours at: https://aistudio.google.com/app/apikey
# --------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# --------------------------------------------------------------
# [OPTIONAL] Google Maps / Places API Key
# Used for advanced interactive maps (if needed)
# Get at: https://console.cloud.google.com/
# --------------------------------------------------------------
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --------------------------------------------------------------
# [OPTIONAL] Gemini Model Name
# Default: gemini-1.5-flash
# Other options: gemini-1.5-pro, gemini-2.0-flash
# --------------------------------------------------------------
# GEMINI_MODEL=gemini-1.5-flash

# --------------------------------------------------------------
# [OPTIONAL] Open-Meteo Weather API
# Currently free, no key required.
# Leave blank to use the default public endpoint.
# --------------------------------------------------------------
# OPEN_METEO_API_URL=https://archive-api.open-meteo.com/v1/archive

# --------------------------------------------------------------
# [OPTIONAL] MongoDB Connection URI & Database Name
# Dùng để lưu trữ dữ liệu đặt lịch khám bệnh trực tuyến
# Ví dụ: mongodb+srv://<user>:<password>@cluster0.mongodb.net/
# Hoặc local: mongodb://localhost:27017/
# --------------------------------------------------------------
MONGODB_URI=your_mongodb_uri_here
MONGODB_DB_NAME=dengue_clinic_db

# --------------------------------------------------------------
# [OPTIONAL] Logging Level: DEBUG | INFO | WARNING | ERROR
# --------------------------------------------------------------
# LOG_LEVEL=INFO